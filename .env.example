# Copy to .env and fill in from your Supabase project settings.
# Only EXPO_PUBLIC_* variables reach the app bundle, which is exactly why
# these two are the only ones here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The ANON key. It is public by design and safe to ship ONLY because
# db/rls.sql constrains it: insert and upsert observations, read the view,
# nothing else.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# NEVER put the service_role key in this file or any other file in this
# repository. It bypasses row-level security entirely. Server-side chores
# such as D-008 retention are run from the Supabase dashboard, not the app.
